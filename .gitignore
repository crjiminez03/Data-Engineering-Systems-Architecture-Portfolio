# ============================================================
# .gitignore — Fabric Portfolio
# ============================================================

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ──────────────────────────────────────
venv/
.venv/
env/
ENV/
.env

# ── Jupyter / Databricks notebooks (local artifacts) ─────────
.ipynb_checkpoints/
*.ipynb

# ── Environment & secrets — NEVER commit these ───────────────
.env
.env.*
*.env
secrets.json
secrets.yaml
credentials.json
local.settings.json
appsettings.local.json

# ── Azure / Fabric config with real values ────────────────────
# Commit template versions only — never files with real URIs,
# tenant IDs, client secrets, or connection strings
**/config/local/
**/config/prod/
**/*_secrets.*
**/*_credentials.*

# ── Delta / Spark local artifacts ────────────────────────────
_delta_log/
.spark-events/
derby.log
metastore_db/
spark-warehouse/
*.parquet
*.delta

# ── OS artifacts ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE artifacts ─────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.code-workspace

# ── Logs & temp files ─────────────────────────────────────────
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo

# ── Data files — do not commit actual data ────────────────────
*.csv
*.xlsx
*.xls
*.parquet
*.json
!**/sample_data/sample_*.json
!**/sample_data/sample_*.csv

# ── Power BI files ────────────────────────────────────────────
*.pbix
*.pbit

# ── Fabric export artifacts ───────────────────────────────────
*.SparkJobDefinition/
*.Lakehouse/
*.Warehouse/
*.DataPipeline/

# ── Node (if any web tooling used) ───────────────────────────
node_modules/
npm-debug.log*
